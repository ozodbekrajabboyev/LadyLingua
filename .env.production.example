# Production Environment Configuration for LadyLingua
# Copy these settings to your .env file when deploying to production

# Application
APP_NAME=LadyLingua
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Security Settings
APP_KEY=base64:5PhBNjnQfIvjxNm7qlsZRPsyUH/+33553XjMshJAukM=

# Database
DB_CONNECTION=sqlite
# For production, consider using MySQL/PostgreSQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ladylingua
# DB_USERNAME=root
# DB_PASSWORD=

# Session Configuration (Production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache Configuration (Production)
CACHE_DRIVER=database
CACHE_PREFIX=ladylingua_cache

# Queue Configuration
QUEUE_CONNECTION=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filament Configuration
FILAMENT_DOMAIN=null
FILAMENT_PATH=platform

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
